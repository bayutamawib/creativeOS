{
  "id": "creativeWeeklyW01",
  "name": "WF-D \u00b7 Weekly schedule",
  "versionId": "468f5ea8-b205-4b48-b47b-ab71bb9f7f37",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "528b8d50-f8a0-4d33-9bb8-ce7226a5b8ca",
      "name": "Weekly schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "position": [
        0,
        0
      ]
    },
    {
      "name": "Register report schedule",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/internal/workflow-runs/report-schedule",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { execution_id: String($execution.id) } }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "creativeCallback1",
          "name": "Creative workflow callbacks"
        }
      },
      "id": "2526d92d-801d-4994-b3bd-a0e176745526",
      "position": [
        260,
        0
      ]
    },
    {
      "id": "93692ea7-c3f5-4e65-906f-43382986c52e",
      "name": "Queue period reports",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/api/v1/internal/workflow-runs/{{ $json.run_id }}/reports",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "position": [
        480,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "creativeCallback1",
          "name": "Creative workflow callbacks"
        }
      }
    },
    {
      "id": "f7260d0e-7369-4431-82d8-234e0cc27eef",
      "name": "Generating",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b8004914-2e4a-4515-aefd-482b3d0cb53d",
              "leftValue": "={{ ['running','pending'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        720,
        0
      ]
    },
    {
      "id": "bfbef1e5-99b8-4d9d-9cf3-0cfb380c4756",
      "name": "Wait for summaries",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "resume": "timeInterval",
        "amount": 3,
        "unit": "seconds"
      },
      "position": [
        920,
        -180
      ]
    },
    {
      "id": "885082c8-028b-4efe-bb69-c05833d24715",
      "name": "Check reports",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "=http://backend:8000/api/v1/internal/workflow-runs/{{ $json.run_id }}/reports",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "position": [
        1100,
        -180
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "creativeCallback1",
          "name": "Creative workflow callbacks"
        }
      }
    },
    {
      "id": "ecaa98ed-fb7b-457e-8089-533bc62b153c",
      "name": "Check outcome",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "025f4577-9ed7-40f1-b616-0a913f2d983c",
              "leftValue": "={{ $json.status === 'failed' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        920,
        120
      ]
    },
    {
      "name": "Report schedule failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "parameters": {
        "errorMessage": "Report schedule failed. Inspect the correlated FastAPI workflow run."
      },
      "id": "ded9bddb-fea2-4672-8b4a-7e389d8dd2ee",
      "position": [
        1120,
        120
      ]
    }
  ],
